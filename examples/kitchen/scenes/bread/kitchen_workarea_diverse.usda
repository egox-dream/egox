    over "Props"
    {
        def Xform "MugLeft" (
            prepend references = @../assets/props/coffee_mug.usdc@
        )
        {
            float xformOp:rotateZ = 20
            double3 xformOp:translate = (-0.3, 0.53, 0.853)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Xform "MugRight" (
            prepend references = @../assets/props/coffee_mug.usdc@
        )
        {
            float xformOp:rotateZ = -45
            double3 xformOp:translate = (1.55, 0.2, 0.853)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

