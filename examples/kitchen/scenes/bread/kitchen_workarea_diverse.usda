#usda 1.0
(
    defaultPrim = "KitchenTwin"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @kitchen_workarea.usda@
    ]
    upAxis = "Z"
)

def Xform "KitchenTwin" (
    customData = {
        bool approximate_reconstruction = 1
        bool dimensions_are_visual_estimates = 1
        string source_dataset = "unreleased:g1/kitchen"
    }
)
{
    custom bool egox:enableReflections = 1

    def "Looks"
    {
        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.75
        }

        def Material "Worktop"
        {
            token outputs:surface.connect = </KitchenTwin/Looks/Worktop/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.28, 0.27, 0.25)
                float inputs:metallic = 0
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "Cabinet"
        {
            token outputs:surface.connect = </KitchenTwin/Looks/Cabinet/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.61, 0.48, 0.31)
                color3f inputs:diffuseColor.connect = </KitchenTwin/Looks/Cabinet/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.48
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (0.47, 0.37, 0.23, 0)
                asset inputs:file = @../assets/room/materials/Wood039/Wood039_2K-JPG_Color.jpg@
                float4 inputs:scale = (0.25, 0.23, 0.18, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </KitchenTwin/Looks/Cabinet/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "PaleWorktop"
        {
