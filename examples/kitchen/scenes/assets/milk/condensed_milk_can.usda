#usda 1.0
(
    defaultPrim = "CondensedMilkCan"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "CondensedMilkCan" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    assetInfo = {
        string name = "Open sweetened condensed milk can"
    }
    customData = {
        int collision_wall_segments = 32
        string description = "Open hollow can with a cream and blue label, metal interior and rolled rim."
        double diameter_m = 0.054
        double height_m = 0.15
        double inner_diameter_m = 0.049
        double interior_floor_z_m = -0.073
        string main_label_faces = "+X"
        double minimum_collision_opening_diameter_m = 0.04876405160693765
    }
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.0007725594, 0.0007725594, 0.00023261875)
    float physics:mass = 0.35
    bool physics:rigidBodyEnabled = 1

    def Scope "Looks"
    {
        def Material "Aluminum"
        {
            token outputs:surface.connect = </CondensedMilkCan/Looks/Aluminum/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68, 0.71, 0.74)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }

        def Material "LidAluminum"
        {
            token outputs:surface.connect = </CondensedMilkCan/Looks/LidAluminum/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.57, 0.6, 0.64)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.36
                token outputs:surface
            }
        }

        def Material "PrintedLabel"
        {
            token outputs:surface.connect = </CondensedMilkCan/Looks/PrintedLabel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.94, 0.79)
                color3f inputs:diffuseColor.connect = </CondensedMilkCan/Looks/PrintedLabel/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @condensed_milk_label.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </CondensedMilkCan/Looks/PrintedLabel/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "clamp"
                color3f outputs:rgb
            }
        }

        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.7
        }
    }

